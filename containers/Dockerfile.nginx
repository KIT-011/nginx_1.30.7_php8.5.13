FROM debian:trixie-slim
ARG NGINX_VERSION=1.30.8
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL --retry 3 https://nginx.org/keys/nginx_signing.key -o /tmp/nginx-signing.asc; \
    gpg --batch --show-keys --with-colons /tmp/nginx-signing.asc > /tmp/nginx-keys; \
    grep -q '^fpr:::::::::573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62:' /tmp/nginx-keys; \
    gpg --batch --dearmor -o /usr/share/keyrings/offline-nginx.gpg /tmp/nginx-signing.asc; \
    printf '%s\n' 'deb [signed-by=/usr/share/keyrings/offline-nginx.gpg] https://nginx.org/packages/debian trixie nginx' \
        > /etc/apt/sources.list.d/offline-nginx.list; \
    apt-get update -o APT::Update::Error-Mode=any; \
    version="$(apt-cache madison nginx | awk -F'|' -v want="$NGINX_VERSION" '{ \
        v=$2; gsub(/[[:space:]]/, "", v); upstream=v; sub(/^[0-9]+:/, "", upstream); \
        if (index(upstream, want "-") == 1) { print v; exit } }')"; \
    if [ -z "$version" ]; then echo "nginx $NGINX_VERSION is unavailable in the signed stable repository" >&2; exit 1; fi; \
    apt-get install -y --no-install-recommends "nginx=$version" "nginx-module-geoip=$version"; \
    test "$(nginx -v 2>&1)" = "nginx version: nginx/$NGINX_VERSION"; \
    rm -rf /var/lib/apt/lists/* /tmp/nginx-signing.asc /tmp/nginx-keys
COPY nginx.conf /etc/nginx/nginx.conf
RUN nginx -t
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
