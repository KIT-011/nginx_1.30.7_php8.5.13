SITE_DIR=/srv/www/bitrix
# Set only if paths in nginx root/alias or Apache DocumentRoot differ from SITE_DIR.
# NGINX_SITE_DIR=/var/www/html/bitrix
# APACHE_SITE_DIR=/var/www/html/bitrix

# Omit NGINX_IMAGE and PHP_IMAGE here when passing the release images.env.
# NGINX_IMAGE=nginx:1.31.7

# Override only when the corresponding host directories differ.
# NGINX_CONFIG_DIR=/etc/nginx
# NGINX_LOG_DIR=/var/log/nginx
# NGINX_HTML_DIR=/usr/share/nginx/html
# APACHE_CONFIG_DIR=/etc/apache2
# APACHE_LOG_DIR=/var/log/apache2
# APACHE_STATE_DIR=/var/lib/apache2
# PHP_CONFIG_DIR=./php
